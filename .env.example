# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MongoDB Atlas
# Cluster: cluster0.mujg0bf.mongodb.net
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.mujg0bf.mongodb.net/sofisam_admin?retryWrites=true&w=majority

# Authentication Secret
# Generate with: openssl rand -base64 32
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# First-Time Super Admin Registration Switch
# Set to 'true' for one-time registration. Set to 'false' once your account is created.
ADMIN_REGISTRATION_ENABLED=true

# Public website
FRONTEND_URL=https://sofisam-seven.vercel.app
